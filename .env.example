# =============================================================
# BACKEND — copy to .env and fill in your values
# =============================================================

# Database
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=verify-full"
DIRECT_URL="postgres://user:password@host:5432/dbname?sslmode=verify-full"

# Auth
AUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:4000"

# App URL — used for Socket.IO CORS and email links
NEXT_PUBLIC_APP_URL="http://localhost:4000"

# Allowed CORS origins (comma-separated, or * for all)
ALLOWED_ORIGINS="http://localhost:3000"

# Port
PORT=4000

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Pusher
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap4"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap4"

# Email (Gmail SMTP)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="you@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"

# eSewa
ESEWA_PRODUCT_CODE=""
ESEWA_SECRET_KEY=""
ESEWA_GATEWAY_URL="https://rc-epay.esewa.com.np/api/epay/main/v2/form"
ESEWA_SKIP_VERIFY="false"

# Khalti
KHALTI_SECRET_KEY="Key ..."
KHALTI_GATEWAY_URL="https://dev.khalti.com/api/v2"
KHALTI_RETURN_URL="http://localhost:4000"

# Groq (AI task generator)
GROQ_API_KEY=""
